 <div class="input-group">
    <Input @type={{this.type}} class={{this.class}} @id={{this.viewId}} @name={{this.name}} placeholder={{this.placeholder}} @value={{this.value}} {{on "keyup" this.handleKeyUp}}
 />
    <span class="input-group-addon password-generator" {{on "click" this.refreshPassword}}>
        <i class="fas fa-sync-alt"></i>
    </span>
    <span class="input-group-addon password-options-btn " {{on "click" this.showPasswordGeneratorOption}}>
        <i class="fas fa-cog"></i>
    </span>
</div>
{{#if (or (and this.showElementMessage (not this.isElementValid)) (and this.showMessage (not this.isElementValid)))}}
    <div class="errors-list">
        {{this.errorMessage}}
    </div>
{{/if}}