{{#if (and this.password.frontendCrypted (not this.isEdit))}}
{{#if this.passwordDescryptionBlocked}}
<p class="alert alert-danger">
    <i class="fas fa-ban"></i>
    {{t 'You exceeded the maximum allowed number of decryption attempts'}}
</p>
{{else}}
<p class="alert alert-pin alert-{{if this.isPinValid 'success' 'danger'}}">
    <i class="fas fa-{{if this.isPinValid 'check-circle' 'exclamation-triangle'}}"></i>
    {{t 'The password is procteted with a PIN:'}}
    <div class="input-group">
        <Input 
		class="form-control" 
		@type="password" 
		@value={{this.pinDecrypt}} 
		@keyDown={{this.protectPassword}} 
		@enter={{this.decryptPassword}} 
		/>
        <span class="input-group-addon btn" {{on "click" this.decryptPassword}}>
            <i class="fas fa-unlock"></i>
        </span>
    </div>
</p>
{{/if}}
{{/if}}
<div class="panel panel-default password-content read">
    {{#if this.isEdit}}
    <div class="panel-heading">
        {{t 'Password\'s details'}}
        <div class="pull-right">
            <div class="btn-group">
                <a class="btn btn-default btn-xs" {{on "click" this.cancel}}>
                    {{t 'Close'}} <i class="fas fa-times"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="panel-body">
        <form class="form-horizontal" {{on "submit" this.submit }}>
            <div class="form-group">
                <label class="control-label col-sm-3">
                    {{t 'Title'}}
                </label>
                <div class="col-sm-9">
                    <Input class="form-control" @value={{this.password.folder_id}} @type="hidden" />
                    <Form::FormText 
					@class="form-control" 
					@name="password-title" 
					@value={{this.password.title}} 
					@isFormValid={{this.isFormValid}} 
					@showMessage={{this.showMessage}} 
					@validator={{validation-parameters required=true minLength=2 maxLength=100 }} />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-3">
                    {{t 'Icon'}}
                </label>
                <div class="col-sm-9">
                    <Form::FormSelect 
					@name="password-icon" 
					@isPowerSelect={{true}}
					@allowClear={{false}} 
					@selectOptions={{this.icons}} 
					@destination="icons-wormhole" 
					@value={{this.password.icon}} 
					@printSelectValuesHandle={{this.printSelectValuesHandle}} 
					@isFormValid={{this.isFormValid}} 
					@showMessage={{this.showMessage}} 
					@validator={{validation-parameters type="select" }} />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-3">
                    {{t 'Description'}}
                </label>
                <div class="col-sm-9">
                    <Form::FormTinymce 
					@options={{this.options}} 
					@name="password-description" 
					@value={{this.password.description}} 
					@isFormValid={{this.isFormValid}} 
					@showMessage={{this.showMessage}} 
					@validator={{validation-parameters maxLength=4000 }} />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-3">
                    {{t 'Username'}}
                </label>
                <div class="col-sm-9">
                    <Form::FormText 
					@class="form-control" 
					@name="password-username" 
					@value={{this.password.username}} 
					@isFormValid={{this.isFormValid}} 
					@showMessage={{this.showMessage}} 
					@validator={{validation-parameters maxLength=45 }} />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-3 with-tooltip">
                    {{t 'Password'}}
                    <a class="btn-tooltip" href="#" data-toggle="tooltip" data-placement="top" title={{t "visiblePassword"}}>
                        <i class="fas fa-info-circle"></i>
                    </a>
                </label>
                <div class="col-sm-9">
                        <Form::FormGeneratePassword 
						@class="form-control" 
						@name="password-password" 
						@value={{this.passwordDecrypted}} 
						@isFormValid={{this.isFormValid}} 
						@showMessage={{this.showMessage}} 
						@keyUpCustomAction={{this.resetPin}} 
						@refreshPassword={{this.refreshPassword}} 
						@showPasswordGeneratorOption={{this.showPasswordGeneratorOption}} 
						@validator={{validation-parameters maxLength=200 }} />
                    {{#if this.passwordDecrypted}}
                    <label>
                        <Input 
						@name="use-pin" 
						@type="checkbox" 
						@checked={{this.password.frontendCrypted}} 
						{{on "change" (fn this.setPassword true)}} 
						/> &nbsp;{{t 'PIN encryption'}}
                    </label>
                    {{/if}}
                    <div class="panel panel-default password-options-form ">
                        <div class="panel-heading">
                            {{t 'Options'}}
                            <div class="pull-right">
                                <div class="btn-group">
                                    <a class="btn btn-default btn-xs password-options-reset"
                                        {{on "click" this.ResetPasswordGenerator}}>
                                        {{t 'Reset'}}
                                    </a>
                                    <a class="btn btn-default btn-xs password-options-close"
                                        {{on "click" this.showPasswordGeneratorOptionClose}}>
                                        {{t 'Close'}}
                                    </a>
                                    <a class="btn btn-default btn-xs password-options-update"
                                        {{on "click" this.GeneratorPassword}}>
                                        {{t 'Update'}}
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="panel-body">
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-sm-3">
                                        {{t 'Length'}}
                                    </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" name="password-length" type="number" value="8" min="1" max="100">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-sm-3">
                                        {{t 'Characters'}}
                                    </label>
                                    <div class="col-sm-9">
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="uppercase" checked> {{t 'uppercase'}}
                                            </label>
                                        </div>
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="lowercase" checked> {{t 'lowercase'}}
                                            </label>
                                        </div>
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="numbers" checked> {{t 'numbers'}}
                                            </label>
                                        </div>
                                        <div class="checkbox">
                                            <label>
                                                <input type="checkbox" name="specialchars"> {{t 'specialChars'}}
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group" hidden={{ if this.password.frontendCrypted '' 'true' }}>
                <label class="control-label col-sm-3">
                    {{t 'PIN'}}
                </label>
                <div class="col-sm-9">
                    <Form::FormText 
                    @class="form-control" 
                    @name="password-pin" 
                    @value={{this.pinEncrypt}} 
                    @isFormValid={{this.isFormValid}} 
                    @showMessage={{this.showMessage}} 
                    @keyUpCustomAction={{this.setPassword}} 
                    @validator={{validation-parameters 
                    required=this.password.frontendCrypted 
                    minLength=2 
                    maxLength=50 }} />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-3">
                    {{t 'Url'}}
                </label>
                <div class="col-sm-9">
                    <Form::FormText @class="form-control" @name="password-url" @value={{this.password.url}} @isFormValid={{this.isFormValid}} @showMessage={{this.showMessage}} @validator={{validation-parameters maxLength=100 }} />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-3">
                    {{t 'Tags'}}
                </label>
                <div class="col-sm-9">
                    <Form::FormText @class="form-control" @name="password-tags" @value={{this.password.tags}} @isFormValid={{this.isFormValid}} @showMessage={{this.showMessage}} @validator={{validation-parameters maxLength=400 }} />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label col-sm-3">
                    {{t 'File'}}
                </label>
                <div class="col-sm-9 file-container">
                    {{#if this.password.fileId }}
                    {{this.password.fileName}}
                    <span class="btn btn-xs btn-default action" {{on "click" this.showDeleteFileConfirm}}>
                        <i class="fas fa-trash"></i>
                    </span>
                    <span class="btn btn-xs btn-default action" {{on "click" this.downloadPasswordFile}}>
                        <i class="fas fa-download"></i>
                    </span>
                    {{else}}
                    <Input @id="file" @name="file" @type="file" />
                    {{/if}}
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-offset-2 col-sm-9">
                    <button type="submit" name="submit" class="btn btn-primary" value="">
                        {{t 'Save'}}
                        <i class="fas fa-save"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
    {{else}}
    <div class="panel-heading">
        {{t 'Password\'s details'}}
        <div class="pull-right">
            {{#if (or this.canAccessAllFolders (eq this.folder.access 2))}}
            <div class="btn-group">
                <a class="btn btn-default btn-xs" {{on "click" this.showConfirm}}>
                    <i class="fas fa-trash"></i>
                </a>
                {{#if (or this.isPinValid (not this.password.frontendCrypted))}}
                <a class="btn btn-default btn-xs" {{on "click" this.editPassword}}>
                    <i class="fas fa-pencil-alt"></i>
                </a>
                {{/if}}
            </div>
            {{/if}}
        </div>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-password-content">
                <tbody>
                    <tr>
                        <th>
                            {{t 'Description'}}
                        </th>
                        <td>
                            {{this.passwordDescritpion}}
                        </td>
                    </tr>
                    <tr>
                        <th>
                            {{t 'Username'}}
                        </th>
                        <td>
                            {{#if this.password.username}}
                            <span id='username-read'>
                                {{this.password.username}}
                            </span>
                            <div class="buttons-container">
                                <a class="btn btn-default btn-xs action" {{on "click" (fn this.selectUsername this.password.username)}}>
                                    <i class="fas fa-copy"></i>
                                </a>
                            </div>
                            {{/if}}
                        </td>
                    </tr>
                    {{#if (or this.isPinValid (not this.password.frontendCrypted))}}
                    <tr>
                        <th>
                            {{t 'Password'}}
                        </th>
                        <td class="password-read-container">
                            {{#if this.password.password}}
                            <span id='password-read' class="{{unless this.isPasswordVisible 'blur'}}">
                                {{this.passwordDecrypted}}
                            </span>
                            <div class="buttons-container">
                                <button type="button" class="btn btn-default btn-xs action" {{on "click" this.togglePasswordVisibility}}>
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="btn btn-default btn-xs action" {{on "click" (fn this.selectPassword this.passwordDecrypted)}}>
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            {{/if}}
                        </td>
                    </tr>
                    {{/if}}
                    <tr>
                        <th>
                            {{t 'Url'}}
                        </th>
                        <td>
                            {{#if this.password.url}}
                            {{this.password.url}}
                            <div class="buttons-container">
                                <a href={{this.password.url}} target="_blank" class="btn btn-default btn-xs action">
                                    <i class="fas fa-external-link-alt"></i>
                                </a>
                            </div>
                            {{/if}}
                        </td>
                    </tr>
                    <tr>
                        <th>
                            {{t 'Tags'}}
                        </th>
                        <td>
                            {{#if this.password.tags}}
                            <ul class="tags">
                                {{#each (w this.password.tags) as |tag|}}
                                <li>
                                    {{tag}}
                                </li>
                                {{/each}}
                            </ul>
                            {{/if}}
                        </td>
                    </tr>
                    <tr>
                        <th>
                            {{t 'File'}}
                        </th>
                        <td>
                            {{#if this.password.fileId }}
                            {{this.password.fileName}}
                            <a class="btn btn-default btn-xs action" {{on "click" this.downloadPasswordFile}}>
                                <i class="fas fa-download"></i>
                            </a>
                            {{/if}}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    {{/if}}
</div>
<div class="panel panel-default password-content edit hide"></div>
{{yield}}



<div class="modal fade" id="deletePasswordConfirm" tabindex="-1" role="dialog" aria-labelledby="modal-delete-password"
    aria-hidden="true">
    <div class="modal-with-action" {{on "click" this.cancelFormConfirm}}></div>
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-delete-password">
                    {{t "Password deletion"}}
                </h5>
            </div>
            <div class="modal-body">
                {{t "Are you sure you want to delete this password?"}}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" {{on "click" this.cancelFormConfirm}}>
                    {{t "Cancel"}}
                </button>
                <button type="button" class="btn btn-danger" {{on "click" (fn this.deletePassword this.password.id)}}>
                    {{t "Delete"}}
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="deleteFilePermissionConfirm" tabindex="-1" role="dialog" aria-labelledby="modal-delete-file"
    aria-hidden="true">
    <div class="modal-with-action" {{on "click" this.cancelDeleteFileConfirm}}></div>
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-delete-file">
                    {{t "File deletion"}}
                </h5>
            </div>
            <div class="modal-body">
                {{t "Are you sure you want to delete this File?"}}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" {{on "click" (fn this.cancelDeleteFileConfirm this.folderUser.id)}}>
                    {{t "Cancel"}}
                </button>
                <button type="button" class="btn btn-danger" {{on "click" (fn this.deletePasswordFile this.folderUser this.folderId)}}>
                    {{t "Delete"}}
                </button>
            </div>
        </div>
    </div>
</div>

<div id="icons-wormhole"></div>