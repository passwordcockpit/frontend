<div class="panel panel-default log">
    <div class="panel-heading">
        {{t 'Password\'s log' }}
    </div>
    <div class="panel-body">
        <div class="alert alert-info">
            <div>
                <i class="fas fa-edit"></i> {{t 'Last password modification'}}: {{this.password.last_modification_date}}
            </div>
            {{#if this.password.last_password_modification_date}}
            <div style="margin-top: 8px">
                <i class="fas fa-key"></i> {{t 'Last password change'}}: {{this.password.last_password_modification_date}}
            </div>
            {{/if}}
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            {{t 'Date'}}
                        </th>
                        <th>
                            {{t 'Username'}}
                        </th>
                        <th>
                            {{t 'Action'}}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.logs as |log|}}
                        <tr>
                            <td class="grid-150">
                                {{log.action_date}}
                            </td>
                            <td>
                                {{log.username}}
                            </td>
                            <td>
                                {{log.action}}
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    {{#if this.logs}}
        <LogPaginator @page={{this.page}} @pageCount={{this.pageCount}} @changePage={{this.submit}} />
    {{/if}}
</div>
{{yield}}