<h1>
    <i class="fas fa-{{this.model.password.icon}}"></i> 
    {{this.model.password.title}}
</h1>
<Password::PasswordContent 
    @password={{this.model.password}} 
    @folder={{this.model.folder}} 
    @onDeletePassword={{this.onDeletePassword}} 
    @onSavePassword={{this.onSavePassword}} 
    @canAccessAllFolders={{this.canAccessAllFolders}} 
    @isPasswordVisible={{this.model.isPasswordVisible}} 
    @isEdit={{this.model.isEdit}} 
    @errors={{this.updatingPasswordErrors}} 
    @canViewLogs={{this.canViewLogs}} 
    @passwordDecrypted={{this.passwordDecrypted}} 
    @pinDecrypt={{this.pinDecrypt}} 
    @isPinValid={{this.isPinValid}} 
    @failureCounted={{this.passwordDescryptionFailureCounted}} 
    @passwordDescryptionBlocked={{this.passwordDescryptionBlocked}} 
/>
{{#if this.canViewLogs}}
    <Password::PasswordLog 
    @logs={{this.logs}} 
    @page={{this.page}} 
    @pageCount={{this.pageCount}} 
    @changeLogPage={{this.changeLogPage}} 
    @refreshLog={{this.refreshLog}} 
    @password={{this.model.password}} 
    @users={{this.model.users}} />
{{/if}}
{{outlet}}